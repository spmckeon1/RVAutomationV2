{
  "notifications": {
    "emailEnabled": true,
    "quietHours": {
      "enabled": true,
      "start": "22:00",
      "end": "07:00"
    }
  },
  "features": {
    "maintenanceMode": false,
    "travelModeEnabled": true
  },
  "preferences": {
    "units": "imperial",
    "timeFormat": "12h"
  },
  "logging": {
    "retentionDays": 30,
    "maxFileSize": "10M",
    "defaultLevel": "INFO",
    "levels": {
      "ERROR": {
        "prefixes": [
          "ERROR:"
        ]
      },
      "WARNING": {
        "prefixes": [
          "WARN:"
        ]
      },
      "INFO": {
        "prefixes": [
          "INFO:"
        ]
      },
      "DEBUG": {
        "prefixes": [
          "DEBUG:"
        ]
      }
    }
  }
}